{
  "id": "ynab",
  "display_name": "YNAB (You Need A Budget)",
  "bank": null,
  "format": "csv",
  "currency_hint": null,
  "source_hint": "YNAB",
  "detect": {
    "headers": ["account", "flag", "date", "payee", "category group/category", "memo", "outflow", "inflow"]
  },
  "options": {
    "encoding": "utf-8",
    "delimiter": ",",
    "decimal_separator": ".",
    "date_format": "%m/%d/%Y",
    "column_map": {
      "date": "Date",
      "amount_in": "Inflow",
      "amount_out": "Outflow",
      "note": "Payee"
    }
  }
}
