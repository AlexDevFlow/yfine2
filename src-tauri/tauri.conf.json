{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yfine",
  "version": "0.1.0",
  "identifier": "com.yfine.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yfine",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "publisher": "AlexDevFlow",
    "licenseFile": "../LICENSE",
    "shortDescription": "Private, local personal-finance app",
    "longDescription": "Track wallets, movements, transfers, recurring bills, savings, goals, budgets and portfolios — entirely on your own machine. No cloud, no accounts, no telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
